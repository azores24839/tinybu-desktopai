{
  "name": "tinybu-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml --target-dir src-tauri/target-check",
    "api:dev": "node apps/api/server.mjs",
    "test:regression": "node --test test/regression.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:ci": "npm run typecheck && npm run test:regression && node --check apps/api/server.mjs && node --check apps/api/providerClients.mjs && node --check apps/api/taskSchemas.mjs && npm run tauri:check && npm run build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "dexie": "^4.2.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
